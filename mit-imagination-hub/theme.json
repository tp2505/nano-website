{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "Base" },
				{ "slug": "base-2", "color": "#f6f6f4", "name": "Base subtle" },
				{ "slug": "contrast", "color": "#111111", "name": "Contrast" },
				{ "slug": "muted", "color": "#6b6b6b", "name": "Muted text" },
				{ "slug": "line", "color": "#e6e6e3", "name": "Hairline" },
				{ "slug": "surface", "color": "#dcdcd9", "name": "Media surface" },
				{ "slug": "footer", "color": "#b9bcee", "name": "Footer" },
				{ "slug": "accent-purple", "color": "#7c3aed", "name": "Accent purple" },
				{ "slug": "accent-yellow", "color": "#f2c200", "name": "Accent yellow" },
				{ "slug": "accent-red", "color": "#e0301e", "name": "Accent red" },
				{ "slug": "accent-green", "color": "#2bb673", "name": "Accent green" },
				{ "slug": "accent-cyan", "color": "#20c4d9", "name": "Accent cyan" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "grotesk",
					"name": "Space Grotesk",
					"fontFamily": "\"Space Grotesk\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/space-grotesk-latin-300-normal.woff2" ]
						},
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/space-grotesk-latin-400-normal.woff2" ]
						},
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/space-grotesk-latin-500-normal.woff2" ]
						},
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [ "file:./assets/fonts/space-grotesk-latin-700-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.8125rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "lead", "size": "1.25rem", "name": "Lead" },
				{ "slug": "large", "size": "clamp(1.5rem, 1.1rem + 1.6vw, 2.1rem)", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(2rem, 1.2rem + 3.4vw, 3.4rem)", "name": "Extra large" },
				{ "slug": "huge", "size": "clamp(2.4rem, 1.3rem + 4.8vw, 4.6rem)", "name": "Huge" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "size": "0.75rem", "name": "1" },
				{ "slug": "30", "size": "1.25rem", "name": "2" },
				{ "slug": "40", "size": "2rem", "name": "3" },
				{ "slug": "50", "size": "3.5rem", "name": "4" },
				{ "slug": "60", "size": "5.5rem", "name": "5" },
				{ "slug": "70", "size": "8rem", "name": "6" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--grotesk)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55",
			"letterSpacing": "-0.005em"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "500",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "front-page", "title": "Front Page", "postTypes": [ "page" ] }
	]
}
